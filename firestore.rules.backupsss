rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the authenticated user is an admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the authenticated user is a juri
    function isJuri() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'juri';
    }

    match /users/{userId} {
      // Allow any authenticated user to query/read profiles (e.g. for checking pre-registration or lists)
      allow read: if request.auth != null;
      
      // Allow users to write their own profile, pre-registered profiles matching their email, or admins
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (resource != null && resource.data.email == request.auth.token.email) ||
        (request.resource != null && request.resource.data.email == request.auth.token.email)
      );
    }

    match /proposals/{proposalId} {
      // Owner can read; Admin can read; Juri can read only if status is Approved
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        (isJuri() && resource.data.status == 'Approved')
      );

      // Owner can create; Admin can create
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid && request.resource.data.status in ['Draft', 'Submitted'] ||
        isAdmin()
      );

      // Owner can update draft; Admin can update any
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && resource.data.status == 'Draft') ||
        isAdmin()
      );

      // Owner can delete draft; Admin can delete any
      allow delete: if request.auth != null && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'Draft') ||
        isAdmin()
      );
    }

    match /bidang/{bidangId} {
      // Anyone authenticated can read categories
      allow read: if request.auth != null;
      // Only admin can write categories
      allow write: if isAdmin();
    }

    match /penilaian/{penilaianId} {
      // Admin has full access; Juri can read/write their own evaluations;
      // Participant (owner of the proposal) can read evaluations.
      allow read: if request.auth != null && (
        isAdmin() || 
        (isJuri() && resource.data.juriId == request.auth.uid) ||
        get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.userId == request.auth.uid
      );
      
      allow write: if request.auth != null && (
        isAdmin() || 
        (isJuri() && (resource == null || resource.data.juriId == request.auth.uid || request.resource.data.juriId == request.auth.uid))
      );
    }

    match /configs/{configId} {
      // Anyone can read config schedules
      allow read: if true;
      // Only admin can write configs, but allow juri to write gemini config
      allow write: if isAdmin() || (configId == 'gemini' && isJuri());
    }

    match /ai_analyses/{proposalId} {
      // Anyone authenticated can read the AI analysis
      allow read: if request.auth != null;
      // Only admin or juri can generate and write/save the AI analysis
      allow write: if request.auth != null && (isAdmin() || isJuri());
    }
  }
}
